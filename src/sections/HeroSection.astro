---
import { heroData, siteConfig } from '../data/content';

const baseUrl = import.meta.env.BASE_URL;
---

<section id="hero" class="hero" aria-label="Giới thiệu Sukhoi Su-30MK2">
  <div class="hero__bg" aria-hidden="true">
    <img
      src={`${baseUrl}images/hero-su30mk2.jpg`}
      alt="Chiến đấu cơ Sukhoi Su-30MK2 của Không quân Nhân dân Việt Nam"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__overlay" aria-hidden="true"></div>

  <div class="container hero__content">
    <div data-animate class="fade-in">
      <div class="hero__overline">
        <span>Hồ sơ hiện vật · Bảo tàng số</span>
      </div>
      <h1 class="hero__title">
        <span>{heroData.designation}</span>
      </h1>
      <p class="hero__fullname-tag">{heroData.fullName}</p>
      <p class="hero__subtitle">{heroData.subtitle}</p>
      <p class="hero__lead">{heroData.intro}</p>
    </div>

    <!-- Quick Facts Plaque -->
    <div class="hero__facts" data-animate class="slide-up" data-animate-delay="2">
      {heroData.quickFacts.map((fact) => (
        <div class="hero__fact-item">
          <span class="hero__fact-label">{fact.label}</span>
          <span class="hero__fact-val">{fact.value}</span>
        </div>
      ))}
    </div>

    <div class="hero__cta-group" data-animate class="slide-up" data-animate-delay="3">
      <a href="#overview" class="btn btn-primary">
        <span>Khám phá hiện vật</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </a>
      <a href="#anatomy" class="btn btn-outline">
        <span>Sơ đồ cấu tạo 2D</span>
      </a>
    </div>
  </div>

  <a href="#overview" class="hero__scroll-indicator" aria-label="Cuộn xuống để xem nội dung">
    <span>Khám phá</span>
  </a>
</section>

<style>
  .hero__fullname-tag {
    font-family: var(--font-heading);
    font-size: clamp(1.125rem, 2vw, 1.5rem);
    color: var(--metallic-champagne, #c9b99a);
    font-style: italic;
    margin-bottom: var(--space-2);
  }

  .hero__lead {
    font-size: clamp(0.95rem, 1.25vw, 1.125rem);
    color: var(--text-on-dark, #e6ecf2);
    line-height: 1.7;
    max-width: 62ch;
    margin-bottom: var(--space-8);
    opacity: 0.9;
  }

  .hero__facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    padding: var(--space-4) var(--space-6);
    background: rgba(10, 22, 40, 0.72);
    border: 1px solid rgba(201, 185, 154, 0.25);
    border-radius: var(--radius-md, 8px);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    max-width: 760px;
  }

  .hero__fact-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__fact-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    color: var(--metallic-champagne, #c9b99a);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hero__fact-val {
    font-family: var(--font-heading, serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--museum-ivory, #f6f8f9);
  }

  @media (min-width: 768px) {
    .hero__facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
