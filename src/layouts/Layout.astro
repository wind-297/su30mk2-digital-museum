---
import '../styles/global.css';
import '../styles/sections.css';
import { siteConfig } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
const fullOgImage = `${baseUrl}images/og-cover.jpg`;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook / Zalo -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />

    <!-- Google Fonts preconnect & stylesheet -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800;900&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Lora:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,600;0,700;1,400;1,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <!-- Back to top button -->
    <button id="back-to-top" class="back-to-top" aria-label="Về đầu trang" title="Về đầu trang">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <!-- Scroll animation & Robust Nav Tracking observer -->
    <script>
      function initAnimations() {
        const animObserver = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              entry.target.classList.add('animate-visible');
              animObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

        document.querySelectorAll('[data-animate]').forEach(el => animObserver.observe(el));
      }

      // Robust Active Nav Tracking (Scrollspy)
      function initActiveNavTracking() {
        const navLinks = document.querySelectorAll('.nav__link, .nav-mobile__link, .nav-link');
        const sectionIds = [
          'overview',
          'history',
          'role',
          'anatomy',
          'technical',
          'vietnam',
          'conclusion',
          'references'
        ];

        function getTrackedSections() {
          return sectionIds
            .map(id => document.getElementById(id))
            .filter((el): el is HTMLElement => el !== null);
        }

        const sections = getTrackedSections();
        if (sections.length === 0 || navLinks.length === 0) return;

        function updateActiveSection() {
          const scrollPos = window.scrollY;
          const headerOffset = 130; // comfortable offset for fixed navbar
          const windowHeight = window.innerHeight;
          const docHeight = document.documentElement.scrollHeight;

          // If near the top (in Hero section), clear active state
          const firstSection = sections[0];
          const firstRect = firstSection.getBoundingClientRect();
          const firstTop = firstRect.top + scrollPos - headerOffset;
          if (scrollPos < firstTop - 40) {
            setActiveSection('');
            return;
          }

          // If scrolled near bottom of page (within 100px), highlight last section (references)
          if (scrollPos + windowHeight >= docHeight - 90) {
            setActiveSection('references');
            return;
          }

          let activeId = '';

          for (let i = 0; i < sections.length; i++) {
            const section = sections[i];
            const rect = section.getBoundingClientRect();
            const top = rect.top + scrollPos - headerOffset;
            const bottom = top + rect.height;

            if (scrollPos >= top && scrollPos < bottom) {
              activeId = section.id;
              break;
            }
          }

          // Fallback if between sections
          if (!activeId) {
            for (let i = sections.length - 1; i >= 0; i--) {
              const section = sections[i];
              const rect = section.getBoundingClientRect();
              const top = rect.top + scrollPos - headerOffset;
              if (scrollPos >= top) {
                activeId = section.id;
                break;
              }
            }
          }

          if (activeId) {
            setActiveSection(activeId);
          }
        }

        function setActiveSection(id: string) {
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (id && href === `#${id}`) {
              link.classList.add('is-active', 'nav-link-active');
            } else {
              link.classList.remove('is-active', 'nav-link-active');
            }
          });
        }

        let ticking = false;
        window.addEventListener('scroll', () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateActiveSection();
              ticking = false;
            });
            ticking = true;
          }
        }, { passive: true });

        window.addEventListener('resize', updateActiveSection, { passive: true });

        // Initial check on load
        updateActiveSection();
      }

      // Back-to-top logic
      function initBackToTop() {
        const backToTopBtn = document.getElementById('back-to-top');
        if (!backToTopBtn) return;

        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            backToTopBtn.classList.add('is-visible', 'visible');
          } else {
            backToTopBtn.classList.remove('is-visible', 'visible');
          }
        }, { passive: true });

        backToTopBtn.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      document.addEventListener('DOMContentLoaded', () => {
        initAnimations();
        initActiveNavTracking();
        initBackToTop();
      });
    </script>
  </body>
</html>
